{
  "name": "basic-eth-wallet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node node_modules/hardhat/dist/src/cli.js test",
    "lint": "node node_modules/solhint/solhint.js 'contracts/**/*.sol'",
    "compile": "node node_modules/hardhat/dist/src/cli.js build",
    "deploy:dry": "node node_modules/hardhat/dist/src/cli.js run scripts/deploy.ts",
    "deploy:sepolia": "node node_modules/hardhat/dist/src/cli.js run scripts/deploy.ts --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "ethers": "^6.17.0",
    "hardhat": "^3.21.2",
    "solhint": "^6.2.5",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "description": "ETH wallet with spender allowances and guardian-based owner recovery"
}
